# Copy to .env and fill in ONE option for AI chat

# Option 1: OpenAI (or compatible API)
OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Option 2: Ollama (free, local) — run: ollama pull llama3.2
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# If neither is set, AI mode uses a built-in local assistant.
